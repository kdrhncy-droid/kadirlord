{
  "name": "kadirlord",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "setup:e2e": "npm --prefix tools/e2e ci && node tools/e2e/setup.mjs",
    "test:e2e": "node tools/e2e/run-e2e.mjs",
    "verify:fast": "tsc --noEmit && tsx src/game/rules.test.ts && tsx scripts/probe-test-harness.ts && tsx scripts/probe-encounter.ts",
    "verify:browser": "npm run test:e2e",
    "verify:armory": "tsx scripts/verify-armory.ts",
    "verify:encyclopedia": "tsx scripts/probe-encyclopedia.ts && tsx scripts/probe-encyclopedia-ui.tsx && tsx scripts/probe-portrait.ts && tsx scripts/probe-portrait-frame.ts",
    "verify:heroes": "tsx scripts/probe-heroes.ts",
    "verify:portrait": "tsx scripts/probe-portrait.ts && tsx scripts/probe-portrait-frame.ts",
    "verify:body": "tsx scripts/probe-body-fit.ts",
    "verify:decals": "tsx scripts/probe-face-decals.ts",
    "verify:ladies": "tsx scripts/probe-ladies.ts",
    "verify:all": "npx tsc --noEmit && npx tsx src/game/rules.test.ts && for f in scripts/probe-*.ts scripts/probe-*.tsx; do npx tsx \"$f\" || exit 1; done"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.186.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
